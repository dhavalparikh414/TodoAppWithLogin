<form asp-page="Index" method="post" asp-page-handler="Add" id="addTodoForm" class="d-flex flex-column flex-sm-row gap-2 mb-4 align-items-stretch align-items-sm-end">
    <div class="flex-grow-1">
        <label class="form-label small text-muted mb-1">What needs to be done?</label>
        <input asp-for="Input.Text" id="todoText" class="form-control" placeholder="e.g. Renew car registration" />
    </div>

    <div>
        <label class="form-label small text-muted mb-1">And by what date &amp; time?</label>
        <input asp-for="Input.DueDate" id="todoDueDate" type="datetime-local" class="form-control" />
        <span asp-validation-for="Input.DueDate" class="text-danger small"></span>
    </div>

    <button type="submit" id="addTodoBtn" class="btn btn-primary text-nowrap" disabled>
        <i class="bi bi-plus-lg"></i>
        Add
    </button>
</form>

<h4>Current Todo's</h4>

@if (!Model.Todos.Any())
{
    <p class="empty">The list is empty</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var todo in Model.Todos)
        {
            <li class="d-flex align-items-center flex-wrap gap-2 mb-2 pb-2 border-bottom">

                <!-- Toggle complete -->
                <form method="post" asp-page-handler="Toggle" asp-route-id="@todo.Id" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-link p-0 me-2" title="Toggle complete">
                        <i class="bi @(todo.IsComplete ? "bi-check-square-fill text-success" : "bi-square")"></i>
                    </button>
                </form>

                <!-- Delete -->
                <form method="post" asp-page="Index" asp-page-handler="Delete" style="display: inline">
                    <input type="hidden" name="Id" value="@todo.Id" />
                    <button type="submit" class="btn btn-link">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>

                <!-- Edit (inline prompt) -->
@*                 <form method="post" asp-page="Index" asp-page-handler="Edit" id="editForm-@todo.Id" style="display: inline">
                    <input type="hidden" name="Id" value="@todo.Id" />
                    <input type="hidden" name="editedText" id="editedText-@todo.Id" />
                    <button type="button" class="btn btn-link edit-btn" data-id="@todo.Id" data-text="@todo.Description">
                        <i class="bi bi-pencil"></i>
                    </button>
                </form> *@

                <!-- Edit through the edit page -->
                <a asp-page="/Todos/Edit" asp-route-id="@todo.Id" class="btn btn-link">
                    <i class="bi bi-pencil"></i>
                </a>

                <span class="me-2 @(todo.IsComplete ? "text-decoration-line-through text-muted" : "")">
                @todo.Description
                </span>
                @if (todo.DueDate.HasValue)
                {
                    var isOverdue = !todo.IsComplete && todo.DueDate.Value < DateTime.Now;
                    <span class="badge @(isOverdue ? "bg-danger" : "bg-secondary")">
                        <i class="bi bi-clock"></i> @todo.DueDate.Value.ToString("dd MMM yyyy, h:mm tt")
                    </span>
                }
            </li>
        }
    </ul>
}
<style>
    .validation-summary-errors ul {
        list-style-type: none;
        color: red;
        padding: 0;
        margin: 0;
    }

    .empty {
        color: lightgray;
    }
</style>

