  @section Scripts {
    <script>
        (function () {
            const textInput = document.getElementById('todoText');
            const dateInput = document.getElementById('todoDueDate');
            const addBtn = document.getElementById('addTodoBtn');

            function checkFields() {
                const hasText = textInput.value.trim().length > 0;
                const hasDate = dateInput.value.trim().length > 0;
                addBtn.disabled = !(hasText && hasDate);
            }

            textInput.addEventListener('input', checkFields);
            dateInput.addEventListener('input', checkFields);
            dateInput.addEventListener('change', checkFields);
        })();
    </script>
    }