@page
@model TodoAppWithLogin.Pages.Todos.IndexModel
@{
    ViewData["Title"] = "My Todos";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
}

<h4>Add a todo</h4>
<form asp-page="Index" method="post" asp-page-handler="Add" class="d-flex gap-2 mb-4">
    <input asp-for="Input.Text" class="form-control flex-grow-1" placeholder="What needs to be done?" />
    <button type="submit" class="btn btn-primary text-nowrap">
        <i class="bi bi-plus-lg"></i>
        Add
    </button>
</form>

<h4>Current Todo's</h4>

@if (!Model.Todos.Any())
{
    <p class="empty">The list is empty</p>
}
else
{
    <ul class="list-unstyled">
        @foreach (var todo in Model.Todos)
        {
            <li>

                <!-- Toggle complete -->
                <form method="post" asp-page-handler="Toggle" asp-route-id="@todo.Id" class="d-inline">
                    <button type="submit" class="btn btn-sm btn-link p-0 me-2" title="Toggle complete">
                        @(todo.IsComplete ? "✅" : "⬜")
                    </button>
                </form>

                <!-- Delete -->
                <form method="post" asp-page="Index" asp-page-handler="Delete" style="display: inline">
                    <input type="hidden" name="Id" value="@todo.Id" />
                    <button type="submit" class="btn btn-link">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>

                <!-- Edit (inline prompt) -->
                <form method="post" asp-page="Index" asp-page-handler="Edit" id="editForm-@todo.Id" style="display: inline">
                    <input type="hidden" name="Id" value="@todo.Id" />
                    <input type="hidden" name="editedText" id="editedText-@todo.Id" />
                    <button type="button" class="btn btn-link edit-btn" data-id="@todo.Id" data-text="@todo.Description">
                        <i class="bi bi-pencil"></i>
                    </button>
                </form>
                @todo.Description
            </li>
        }
    </ul>
}
<style>
    .validation-summary-errors ul {
        list-style-type: none;
        color: red;
        padding: 0;
        margin: 0;
    }

    .empty {
        color: lightgray;
    }
</style>

@section Scripts {
    <script>
        document.querySelectorAll('.edit-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const id = this.dataset.id;
                const currentText = this.dataset.text;
                const newText = prompt("Edit todo:", currentText);
                if (newText !== null && newText.trim() !== "") {
                    document.getElementById("editedText-" + id).value = newText;
                    document.getElementById("editForm-" + id).submit();
                }
            });
        });
    </script>
}